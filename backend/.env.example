# Copy to backend/.env and fill in. Never commit the real .env.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number in dev; your registered WhatsApp sender in prod
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Voice-capable Twilio number
TWILIO_VOICE_FROM=+1xxxxxxxxxx
# Optional
TWILIO_MESSAGING_SERVICE_SID=

# Public URL of this backend, no trailing slash. Used for webhook URLs and
# Twilio signature validation, so it must match exactly what Twilio calls.
PUBLIC_BASE_URL=https://your-backend.onrender.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Not used (tokens are checked with Supabase Auth directly); may stay empty
SUPABASE_JWT_SECRET=

# Shared secret the cron job sends in the X-Cron-Secret header
CRON_SECRET=

# Origin of the admin web app, for CORS
WEB_ORIGIN=http://localhost:3000

CALL_FALLBACK_HOURS=6
CALL_WINDOW_START=09:00
CALL_WINDOW_END=19:00
APP_TIMEZONE=Asia/Kolkata
SEND_CONCURRENCY=10
